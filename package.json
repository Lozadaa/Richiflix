{
  "name": "richiflix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "node --test src/*.test.js",
    "build:tizen": "vite build --mode tizen && node scripts/package-tizen.mjs",
    "preview:tizen": "vite preview --outDir dist-tizen --host 127.0.0.1",
    "test:tizen": "node scripts/pc-experience-smoke.mjs",
    "brand:export": "node scripts/export-brand.mjs",
    "windows:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-shortcut.ps1",
    "test:pc": "npm run build:tizen && node scripts/pc-experience-smoke.mjs && node scripts/card-loading-smoke.mjs && node scripts/banner-artwork-smoke.mjs && node scripts/artwork-cache-smoke.mjs"
  },
  "dependencies": {
    "hls.js": "^1.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wicg-inert": "^3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "fflate": "^0.8.3",
    "vite": "^7.0.0"
  },
  "description": "Tu biblioteca local para Windows y Samsung TV, con IPTV, perfiles y navegación por mando."
}
